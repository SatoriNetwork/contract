{
  "name": "satori-indexer",
  "version": "0.1.0",
  "private": true,
  "description": "Companion event indexer for the Satori dapp: ingests the five history event streams, serves the computed views the UI needs. Single docker image + one volume.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "ethers": "^6.16.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
